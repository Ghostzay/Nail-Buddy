# Supabase
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Translation (optional — the "Translate to Vietnamese" button on /tech
# only works if one of these is set; leave both unset to disable it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Seed script only (scripts/seed.ts). Server-side, NEVER NEXT_PUBLIC_.
# Project Settings -> API -> service_role. Do not commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Shown on the kiosk welcome screen.
NEXT_PUBLIC_SALON_NAME=Nail Buddy

# Feature flags — turn each on only AFTER applying the matching migration.
# See supabase/migrations/README.md.
NEXT_PUBLIC_FF_CLIENT_IDENTITY=false
NEXT_PUBLIC_FF_SERVICES_TECHS=false
NEXT_PUBLIC_FF_JOB_LIFECYCLE=false
